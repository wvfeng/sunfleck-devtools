<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.1</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);skia-spike/**;obj/**;bin/**</DefaultItemExcludes>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sunfleck.Tests" />
    <Reference Include="Sunfleck.ComponentGenerator" HintPath="$(SunfleckSdkRoot)/lib/sunfleck/components/Sunfleck.ComponentGenerator.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
    <Content Include="$(SunfleckSdkRoot)/share/sunfleck/types/Elements.cs" Link="types/Elements.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(SunfleckSdkRoot)/share/sunfleck/types/Components.cs" Link="types/Components.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="$(SunfleckSdkRoot)/share/sunfleck/Sunfleck.props"
          Condition="'$(SunfleckSdkRoot)' != '' and Exists('$(SunfleckSdkRoot)/share/sunfleck/Sunfleck.props')" />
  <Target Name="CheckSunfleckSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SunfleckSdkRoot)' == '' or !Exists('$(SunfleckSdkRoot)/share/sunfleck/Sunfleck.props')"
           Text="Set SunfleckSdkRoot to the installed desktop SDK." />
  </Target>
</Project>

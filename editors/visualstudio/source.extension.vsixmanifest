<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Sunfleck.Fleck.LanguageService" Version="1.0.0" Language="en-US" Publisher="Sunfleck" />
    <DisplayName>Sunfleck Fleck</DisplayName>
    <Description xml:space="preserve">Fleck language service for Sunfleck C, C++ and C# applications.</Description>
    <License>LICENSE</License>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)"><ProductArchitecture>amd64</ProductArchitecture></InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="Sunfleck.VisualStudio.dll" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="Fleck.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="Sunfleck.VisualStudio.pkgdef" />
  </Assets>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(SunfleckTestFont)" Link="font-fixture.ttf" CopyToOutputDirectory="PreserveNewest" Condition="'$(SunfleckTestFont)' != ''" />
    <Compile Include="../../editors/visualstudio/FleckModelDiscovery.cs" Link="FleckModelDiscovery.cs" />
    <ProjectReference Include="../../tools/development/Sunfleck.Development.csproj" />
  </ItemGroup>
  <Import Project="$(SunfleckSdkRoot)/share/sunfleck/Sunfleck.props"
          Condition="'$(SunfleckSdkRoot)' != '' and Exists('$(SunfleckSdkRoot)/share/sunfleck/Sunfleck.props')" />
  <Target Name="CheckSunfleckSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SunfleckSdkRoot)' == '' or !Exists('$(SunfleckSdkRoot)/share/sunfleck/Sunfleck.props')"
           Text="Set SunfleckSdkRoot to the installed desktop SDK." />
  </Target>
</Project>
